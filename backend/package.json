    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
