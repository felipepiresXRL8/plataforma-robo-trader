{
  "name": "plataforma-robo-trader",
  "version": "1.0.0",
  "description": "Plataforma de Trading + Robô Quant (LightGBM) + Agente IA (Gemini) para B3",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:bot": "python -m uvicorn quant_bot.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "test:backend": "npm --prefix backend run test",
    "test:bot": "python -m pytest quant_bot/tests",
    "test:all": "npm run test:backend && npm run test:bot",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build:backend && npm run build:frontend"
  },
  "keywords": [
    "trading",
    "quant",
    "machine-learning",
    "lightgbm",
    "gemini-ai",
    "sqlite",
    "react",
    "typescript",
    "fastapi"
  ],
  "author": "",
  "license": "MIT"
}
